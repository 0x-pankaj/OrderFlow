generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id              String      @id @default(uuid())
  orderKey        String      @unique
  maker           String
  inputMint       String
  outputMint      String
  makingAmount    BigInt
  takingAmount    BigInt
  oriMakingAmount BigInt
  oriTakingAmount BigInt
  expiredAt       DateTime
  createdAt       DateTime
  updatedAt       DateTime    @updatedAt
  status          OrderStatus @default(OPEN)
  uniqueId        BigInt

  @@index([maker])
  @@index([inputMint])
  @@index([status])
}

enum OrderStatus {
  OPEN
  FILLED
  CANCELLED
}
